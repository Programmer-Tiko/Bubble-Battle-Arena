# Copy to .env to override the local defaults in docker-compose.yml.
# `docker compose up` works without a .env file (local development defaults).
# For the deployed server, ALWAYS set a real password and COOKIE_SECURE=true.

POSTGRES_USER=bubble
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bubble

# Exact origins allowed to POST to /register, /login, /logout (comma separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# false only for local HTTP; true (the default when unset in the auth server) for HTTPS
COOKIE_SECURE=false